{
  "name": "@eventra_dev/cli-plugin-angular",
  "version": "1.0.2",
  "description": "Eventra CLI plugin — extract track() calls from Angular component templates",
  "license": "MIT",
  "type": "commonjs",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/and-1991/eventra-cli-plugin-angular"
  },
  "homepage": "https://eventra.dev",
  "engines": {
    "node": "^20.19.0 || ^22.12.0 || >=24.0.0"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "clean": "rm -rf dist",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage"
  },
  "dependencies": {
    "@angular/compiler": "^20.3.30",
    "typescript": "^5.3.0"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "@vitest/coverage-v8": "^4.1.7",
    "vitest": "^4.1.7"
  },
  "keywords": [
    "eventra",
    "eventra-cli",
    "angular",
    "component",
    "static-analysis",
    "analytics",
    "plugin"
  ],
  "publishConfig": {
    "access": "public"
  }
}
